# Logs
logs/
*.log

# Trained models (large binaries). Models already committed stay tracked
# via their index entry; new training outputs are not auto-added.
models/*.h5
models/*.keras
models/*.pth
models/*.pt
!models/.gitkeep

# Keep .env.example tracked
!.env.example

# Raw / augmented / dataset media — ignore all content, keep the .gitkeep
# markers. Ignoring `data/**` (content) rather than `data/foo/` (the
# directory) lets Git still descend so the .gitkeep re-includes work; a
# directory-level ignore would make `!.../.gitkeep` ineffective.
data/**
!data/**/
!data/**/.gitkeep
# Committed dataset registry (ADR-0019): licences, manifest, frozen test sets — text, no pixels.
!data/registry/**

# SonarQube scan artefacts
coverage.xml
.scannerwork/

# Third-party datasets (downloaded locally, never committed)
data/external/
