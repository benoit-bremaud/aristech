# Byte-compiled / optimized / DLL files
__pycache__/        # Ignore Python bytecode cache
*.py[cod]           # Ignore compiled Python files
*$py.class          # Ignore Jython compiled files

# C extensions
*.so                # Ignore compiled C extensions

# Distribution / packaging
.Python             # Ignore virtual environment folder
build/              # Ignore build artifacts
develop-eggs/       # Ignore development eggs
dist/               # Ignore distribution files
downloads/          # Ignore downloaded files
eggs/               # Ignore eggs
.eggs/              # Ignore eggs (alternative folder)
lib/                # Ignore library files
lib64/              # Ignore library files (alternative folder)
parts/              # Ignore build parts
sdist/              # Ignore source distribution files
var/                # Ignore variable files
wheels/             # Ignore wheel files
share/python-wheels/    # Ignore shared wheel files
*.egg-info/         # Ignore egg metadata
.installed.cfg      # Ignore installed configuration
*.egg               # Ignore egg files
MANIFEST            # Ignore manifest file

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest          # Ignore PyInstaller manifest files
*.spec              # Ignore PyInstaller spec files

# Installer logs
pip-log.txt         # Ignore pip installation logs
pip-delete-this-directory.txt   # Ignore pip installation logs

# Unit test / coverage reports
htmlcov/            # Ignore HTML coverage reports
.tox/               # Ignore tox virtual environment
.nox/               # Ignore nox virtual environment
.coverage           # Ignore coverage report
.coverage.*         # Ignore coverage report
.cache              # Ignore cache files
nosetests.xml       # Ignore nose test result XML
coverage.xml        # Ignore coverage XML report
*.cover             # Ignore coverage report
*.py,cover          # Ignore coverage report
.hypothesis/        # Ignore Hypothesis test data
.pytest_cache/      # Ignore pytest cache
cover/              # Ignore coverage report

# Translations
*.mo                # Ignore compiled message catalogs
*.pot               # Ignore message template files

# Django stuff:
*.log               # Ignore Django log files
local_settings.py   # Ignore local Django settings
db.sqlite3          # Ignore SQLite database
db.sqlite3-journal  # Ignore SQLite journal file

# Flask stuff:
instance/           # Ignore Flask instance folder
.webassets-cache/   # Ignore Flask web assets cache

# Scrapy stuff:
.scrapy             # Ignore Scrapy project files

# Sphinx documentation
docs/_build/        # Ignore Sphinx documentation build files

# PyBuilder
.pybuilder/         # Ignore PyBuilder project files
target/             # Ignore PyBuilder build target

# Jupyter Notebook
.ipynb_checkpoints/ # Ignore Jupyter Notebook checkpoints

# IPython
profile_default/    # Ignore IPython profile
ipython_config.py   # Ignore IPython configuration

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version   # Ignore pyenv version file

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock       # Ignore pipenv lock file

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock        # Ignore poetry lock file

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock           # Ignore pdm lock file
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/#use-with-ide
.pdm.toml           # Ignore pdm configuration file

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/    # Ignore PEP 582 virtual environment

# Celery stuff
celerybeat-schedule    # Ignore Celery beat schedule
celerybeat.pid         # Ignore Celery beat PID file

# SageMath parsed files
*.sage.py           # Ignore SageMath parsed files

# Environments
.env                # Ignore environment file
.venv               # Ignore virtual environment folder
env/                # Ignore environment folder
venv/               # Ignore virtual environment folder
ENV/                # Ignore environment folder
env.bak/            # Ignore backup environment folder
venv.bak/           # Ignore backup virtual environment folder

# Spyder project settings
.spyderproject      # Ignore Spyder project file
.spyproject         # Ignore Spyder project file

# Rope project settings
.ropeproject        # Ignore Rope project file

# mkdocs documentation
/site               # Ignore mkdocs documentation build files

# mypy
.mypy_cache/        # Ignore mypy cache
.dmypy.json         # Ignore mypy configuration
dmypy.json          # Ignore mypy configuration

# Pyre type checker
.pyre/              # Ignore Pyre type checker files

# pytype static type analyzer
.pytype/            # Ignore pytype configuration

# Cython debug symbols
cython_debug/       # Ignore Cython debug symbols

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/             # Ignore PyCharm project files

# Logs
logs/               # Ignore log files
*.log               # Ignore log files

# Environment variable files
.env                # Ignore environment variable file

# Do not ignore .env.example
!.env.example       # Do not ignore .env.example file

# Ignorer les images et les vidéos téléchargées
data/raw_images/                # Ignore raw images folder
!data/raw_images/.gitkeep       # Do not ignore .gitkeep file in raw images folder
data/raw_images/inaturalist/    # Ignore inaturalist raw images folder
!data/raw_images/inaturalist/.gitkeep   # Do not ignore .gitkeep file in inaturalist raw images folder
data/raw_images/gbif/          # Ignore gbif raw images folder
!data/raw_images/gbif/.gitkeep # Do not ignore .gitkeep file in gbif raw images folder
data/raw_images/flickr/        # Ignore flickr raw images folder
!data/raw_images/flickr/.gitkeep   # Do not ignore .gitkeep file in flickr raw images folder
data/raw_images/google/        # Ignore google raw images folder
!data/raw_images/google/.gitkeep   # Do not ignore .gitkeep file in google raw images folder

data/raw_videos/                # Ignore raw videos folder
!data/raw_videos/.gitkeep       # Do not ignore .gitkeep file in raw videos folder
data/raw_videos/inaturalist/    # Ignore inaturalist raw videos folder
!data/raw_videos/inaturalist/.gitkeep   # Do not ignore .gitkeep file in inaturalist raw videos folder
data/raw_videos/gbif/          # Ignore gbif raw videos folder
!data/raw_videos/gbif/.gitkeep # Do not ignore .gitkeep file in gbif raw videos folder
data/raw_videos/flickr/        # Ignore flickr raw videos folder
!data/raw_videos/flickr/.gitkeep   # Do not ignore .gitkeep file in flickr raw videos folder
data/raw_videos/google/        # Ignore google raw videos folder
!data/raw_videos/google/.gitkeep   # Do not ignore .gitkeep file in google raw videos folder

data/augmented_images/         # Ignore augmented images folder
!data/augmented_images/.gitkeep    # Do not ignore .gitkeep file in augmented images folder
data/augmented_videos/         # Ignore augmented videos folder
!data/augmented_videos/.gitkeep    # Do not ignore .gitkeep file in augmented videos folder

data/dataset_images/           # Ignore dataset images folder
!data/dataset_images/.gitkeep  # Do not ignore .gitkeep file in dataset images folder
data/dataset_images/train/     # Ignore train dataset images folder
!data/dataset_images/train/.gitkeep    # Do not ignore .gitkeep file in train dataset images folder
data/dataset_images/validation/    # Ignore validation dataset images folder
!data/dataset_images/validation/.gitkeep   # Do not ignore .gitkeep file in validation dataset images folder
data/dataset_images/test/      # Ignore test dataset images folder
!data/dataset_images/test/.gitkeep    # Do not ignore .gitkeep file in test dataset images folder

data/dataset_videos/           # Ignore dataset videos folder
!data/dataset_videos/.gitkeep  # Do not ignore .gitkeep file in dataset videos folder
data/dataset_videos/train/     # Ignore train dataset videos folder
!data/dataset_videos/train/.gitkeep    # Do not ignore .gitkeep file in train dataset videos folder
!data/dataset_videos/validation/    # Ignore validation dataset videos folder
!data/dataset_videos/validation/.gitkeep   # Do not ignore .gitkeep file in validation dataset videos folder
!data/dataset_videos/test/      # Ignore test dataset videos folder
!data/dataset_videos/test/.gitkeep    # Do not ignore .gitkeep file in test dataset videos folder
