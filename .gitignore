# Trained models (large binaries). Models already committed stay tracked
# via their index entry; new training outputs are not auto-added.
models/*.h5
models/*.keras
models/*.pth
models/*.pt
!models/.gitkeep

# Keep .env.example tracked
!.env.example

# Raw / augmented / dataset media — ignore content, keep the .gitkeep markers
