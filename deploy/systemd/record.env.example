# Copy to /etc/aristech/record.env and edit; never commit the real file.
# ARISTECH_OUTPUT must stay under /mnt/ssd (the unit's mount check and ReadWritePaths);
# another mount needs a drop-in (systemctl edit aristech-record).
ARISTECH_RIG_ID=rig-1
ARISTECH_HIVE_ID=hive-a
ARISTECH_SITE=home garden
ARISTECH_LATITUDE=48.85
ARISTECH_LONGITUDE=2.35
ARISTECH_OUTPUT=/mnt/ssd/segments
# The git SHA of /opt/aristech; update it after every pull (docs/INSTALL.md).
ARISTECH_SOFTWARE_VERSION=unknown
