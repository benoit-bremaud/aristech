# Copy to .env and adjust. Lists only the variables the code reads.

# --- Image dataset split (scripts/distribute_images.py, tests/config) ---
SOURCE_FOLDER=path/to/image_source_folder
TRAIN_FOLDER=data/images/train
VALIDATION_FOLDER=data/images/validation
TEST_FOLDER=data/images/test

# --- Video dataset split (scripts/distribute_videos.py) ---
# Separate variables so images and videos can share one .env.
VIDEO_SOURCE_FOLDER=path/to/video_source_folder
VIDEO_TRAIN_FOLDER=data/videos/train
VIDEO_VALIDATION_FOLDER=data/videos/validation
VIDEO_TEST_FOLDER=data/videos/test

# --- VespAI integration test (tests/integration/test_vespai_detector.py) ---
# Weights are CC BY-NC-SA: keep them outside the repository.
VESPAI_WEIGHTS=path/to/vespai_weights.pt
VESPAI_YOLOV5_DIR=path/to/yolov5
VESPAI_SAMPLE_IMAGE=path/to/hornet_sample.jpg
